:: StoryStylesheet [stylesheet]
/* =================================
   GENERAL PAGE STYLING
================================= */

html, body {
  background: #0F1220;
}

tw-story {
  background: #0F1220;
  color: #F1F2F5;
  font-family: Helvetica, "Helvetica Neue", Arial, sans-serif;
  font-size: 1.1rem;
  line-height: 1.6;
}

tw-passage {
  max-width: 55rem;
  width: calc(100% - 3rem);
  margin: 0 auto;
  padding: 2rem 1.5rem;
  box-sizing: border-box;
}

/* Desktop content positioning */
@media (min-width: 1200px) {
  tw-story {
    margin: 0;
    padding: 0;
    max-width: none;
  }

  tw-passage {
    width: 72%;
    max-width: 55rem;
    margin-left: 22%;
    margin-right: auto;
  }
}

/* Hide Harlowe's default undo/redo icons */
tw-sidebar {
  display: none;
}

/* =================================
   HEADINGS
================================= */

h1, h2, h3 {
  font-weight: bold;
}

h1 {
  color: #E0A0C0;
  border-bottom: 3px solid #E0A0C0;
  padding-bottom: 0.4rem;
}

h2 {
  color: #E0A0C0;
}

h3 {
  color: #78A9D8;
}

/* =================================
   EXTERNAL LINKS
================================= */

tw-passage a {
  color: #B9C0CE;
  font-weight: bold;
  text-decoration: underline;
}

tw-passage a:hover {
  color: #78A9D8;
}

/* =================================
   IMAGES AND TABLES
================================= */

tw-passage img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 1.5rem auto;
}

strong, b {
  color: #78A9D8;
}

tw-passage table {
  margin-top: 0;
}

/* =================================
   MAIN PAGE PASSAGE LINKS (BUTTONS)
================================= */

tw-passage tw-link {
  display: inline-block;
  background: #78A9D8;
  color: #0F1220;
  font-size: 1rem;
  font-weight: bold;
  text-decoration: none;
  padding: 0.7rem 1.4rem;
  margin-top: 1.5rem;
  border-radius: 6px;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* Visited passage links: same text colour, pink button */
tw-passage tw-link.visited {
  background: #E0A0C0;
  color: #0F1220;
}

tw-passage tw-link:hover {
  background: #E0A0C0;
  color: #0F1220;
}

/* link-reveal links sit inside a tw-hook: plain text links */
tw-passage tw-hook > tw-link {
  display: inline;
  background: none;
  color: #B9C0CE;
  font-weight: bold;
  text-decoration: underline;
  padding: 0;
  margin: 0;
  border-radius: 0;
}

tw-passage tw-hook > tw-link:hover {
  background: none;
  color: #78A9D8;
}

/* Survey link as a button */
tw-passage a.survey-btn {
  display: inline-block;
  background: #78A9D8;
  color: #0F1220;
  font-size: 1rem;
  font-weight: bold;
  text-decoration: none;
  padding: 0.7rem 1.4rem;
  margin-top: 1.5rem;
  border-radius: 6px;
  transition: background-color 0.2s ease, color 0.2s ease;
}

tw-passage a.survey-btn:hover {
  background: #E0A0C0;
  color: #0F1220;
}

/* =================================
   SIDEBAR (header-tagged passage)
================================= */

tw-include[type="header"] {
  display: block;
  position: fixed;
  top: 1rem;
  left: 1%;
  width: 18%;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 1rem;
  background: #192238;
  border: 1px solid #26364D;
  border-radius: 12px;
  z-index: 100;
}

tw-include[type="header"] br {
  display: none;
}

/* Sidebar links: plain text links (including Back) */
tw-include[type="header"] tw-link {
  display: block;
  background: none;
  color: #B9C0CE;
  font-size: 0.85rem;
  font-weight: normal;
  text-decoration: none;
  text-align: left;
  padding: 0.25rem 0;
  margin: 0 0 0.2rem;
  border-radius: 0;
  transition: color 0.2s ease;
}

tw-include[type="header"] tw-link:hover {
  background: none;
  color: #78A9D8;
  text-decoration: underline;
}

/* Visited sidebar links */
tw-include[type="header"] tw-link.visited {
  background: none;
  color: #E0A0C0;
}

/* =================================
   SMALLER SCREENS
================================= */

@media (max-width: 1199px) {
  tw-include[type="header"] {
    position: static;
    width: 100%;
    max-width: 55rem;
    max-height: 300px;
    margin: 0 auto 2rem;
  }

  tw-passage {
    margin-left: auto;
    margin-right: auto;
  }
}